pub struct TraceabilityResult {
  event_count : Int
  unique_lots : Int
  missing_evidence : Int
  failed_events : Int
  chronological : Bool
  complete : Bool
} derive(ToJson, @debug.Debug)

pub(all) struct Trend {
  slope : Double
  intercept : Double
  r_squared : Double
} derive(ToJson, @debug.Debug)

pub struct TrendAlert {
  metric : String
  direction : Int
  slope : Double
  confidence : Double
  start_index : Int
  end_index : Int
  message : String
} derive(ToJson, @debug.Debug)

pub(all) struct ValidationIssue {
  index : Int
  field : String
  message : String
} derive(ToJson, @debug.Debug)

// Type aliases
pub type MaybeMeasurement = Double?

// Traits
